# ──────────────────────────────────────────────────────────────
# Claw — AI Coding Assistant — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values for your provider.
#
# Launcher scripts auto-load the repo-root `.env` file.
# Explicit shell exports take precedence over values in `.env`.
#
# Only ONE provider section needs to be configured.
# Default provider is "auto":
# - prefer local Ollama when it is reachable
# - prefer GPU-backed local inference when the local runtime supports it
# - fall back cleanly when local Ollama is unavailable

# ── Provider Selection ─────────────────────────────────────────
# Options: auto, ollama, anthropic, zai, openai, deepseek, groq, openrouter, gemini, lmstudio
# Use `./scripts/run-auto.sh` for the recommended default local startup.
CLAW_PROVIDER=auto

# ── Ollama (Local, Free) ──────────────────────────────────────
# Launcher: ./scripts/run-ollama.sh
# Just run: ollama pull qwen2.5-coder:7b
# No API key needed.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=http://localhost:11434/v1      # optional explicit override
# OPENAI_MODEL=qwen2.5-coder:7b
# CLAW_MODEL=qwen2.5-coder:7b                    # optional alternative model variable

# ── OpenAI ────────────────────────────────────────────────────
# CLAW_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# ── Anthropic (native SDK) ────────────────────────────────────
# Launcher: ./scripts/run-claude.sh
# CLAW_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAW_MODEL=claude-sonnet-4-20250514

# ── Z.AI / GLM-5.1 (OpenAI-Compatible Coding Endpoint) ────────
# Launcher: ./scripts/run-glm.sh
# CLAW_PROVIDER=zai
# ZAI_API_KEY=your-zai-key-here
# OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# ZAI_MODEL=glm-5.1

# ── DeepSeek ──────────────────────────────────────────────────
# CLAW_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-key-here
# OPENAI_MODEL=deepseek-chat

# ── Groq ──────────────────────────────────────────────────────
# CLAW_PROVIDER=groq
# GROQ_API_KEY=your-key-here
# OPENAI_MODEL=llama-3.3-70b-versatile

# ── OpenRouter ────────────────────────────────────────────────
# CLAW_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-key-here
# OPENAI_MODEL=anthropic/claude-sonnet-4-20250514

# ── Google Gemini ─────────────────────────────────────────────
# CLAW_PROVIDER=gemini
# GEMINI_API_KEY=your-key-here
# OPENAI_MODEL=gemini-2.5-flash

# ── LM Studio (Local) ────────────────────────────────────────
# CLAW_PROVIDER=lmstudio
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=your-loaded-model

# ── Custom OpenAI-Compatible Server ──────────────────────────
# Works with ANY server that exposes /v1/chat/completions
# CLAW_PROVIDER=openai
# OPENAI_BASE_URL=http://your-server:8080/v1
# OPENAI_API_KEY=your-key
# OPENAI_MODEL=your-model
